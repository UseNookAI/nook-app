{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nook",
  "mainBinaryName": "Nook",
  "identifier": "ai.nook.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nook - Private and secure AI on your GPU",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$LOCALDATA/Nook-rs/videos/**", "$LOCALDATA/Nook-rs/flows/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nook",
    "shortDescription": "Private and secure AI on your GPU",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
