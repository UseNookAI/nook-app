{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nook - Private and secure AI on your GPU",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        },
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Nook/videos/**",
          "$LOCALDATA/Nook/flows/**"
        ]
      }
    }
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "macos/Nook.entitlements",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 180
        }
      }
    }
  }
}
